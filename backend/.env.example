# Copier ce fichier en .env et adapter les valeurs.
# .env n'est jamais commité (voir .gitignore).

# ==================================================
# Application
# ==================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ==================================================
# Base de données
# ==================================================

DATABASE_URL=postgresql://lovecanbuild:lovecanbuild_dev_pw@localhost:5432/lovecanbuild

# ==================================================
# JWT (Document 13 Ch.6) — générer des secrets distincts et longs pour
# chaque environnement, jamais partagés, jamais commités.
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==================================================

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Fenêtre glissante d'inactivité (Document 13 Ch.6.7)
SESSION_IDLE_TIMEOUT_MINUTES=30

# Origine autorisée pour les requêtes CORS (Document 13 Ch.12.1)
CORS_ORIGIN=http://localhost:5173
