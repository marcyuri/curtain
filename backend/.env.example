# Copier ce fichier en .env et adapter les valeurs.
# .env n'est jamais commité (voir .gitignore).

# ==================================================
# Application
# ==================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ==================================================
# Base de données
# ==================================================

DATABASE_URL=postgresql://lovecanbuild:lovecanbuild_dev_pw@localhost:5432/lovecanbuild

