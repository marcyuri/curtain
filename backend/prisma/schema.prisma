// Document 13 — Chapitre 4 (Architecture Prisma).
// Premier schéma : uniquement le socle Auth/RBAC (Étape 3), rien
// d'autre — les modules métier (products, orders...) arriveront aux
// phases suivantes de la roadmap (Document 13 Ch.15).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE — Users, Roles, Permissions (Document 06 Ch.4/5/6)
// ============================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  avatar       String?
  status       UserStatus @default(ACTIVE)
  language     String   @default("fr")
  timezone     String   @default("Africa/Douala")
  emailVerifiedAt DateTime? @map("email_verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  roles         UserRole[]
  refreshTokens RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  files                   File[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String @id @default(uuid())
  key         String @unique
  label       String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  module      String
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

// Table de jonction User <-> Role (Document 13 Ch.7.1 — un utilisateur
// peut avoir plusieurs rôles, jamais un rôle unique codé en dur).
model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@map("user_roles")
}

// Table de jonction Role <-> Permission.
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// AUTH — Sessions (Document 13 Ch.6, session glissante Ch.6.7)
// ============================================================

model RefreshToken {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  tokenHash String @unique @map("token_hash")

  // Deux expirations distinctes (Document 13 Ch.6.7) :
  idleExpiresAt     DateTime @map("idle_expires_at")     // glissante, 30 min
  absoluteExpiresAt DateTime @map("absolute_expires_at") // fixe, 30 jours

  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Token à usage unique, courte durée de vie (1h, Document 13 Ch.6.6).
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Token à usage unique envoyé à l'inscription (Document 06 Ch.6).
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ============================================================
// FILES — Stockage centralisé (Document 06 Ch.12, Document 13 Ch.11.1)
// Jamais un upload spécifique par module : tous les fichiers passent
// par ce modèle unique, rattachés à une entité via purpose + ownerId.
// ============================================================
model File {
  id       String @id @default(uuid())
  ownerId  String @map("owner_id")

  purpose  String   // ex: "product_image", "invoice_pdf", "avatar"
  url      String
  mimeType String   @map("mime_type")
  size     Int      // octets

  createdAt DateTime @default(now()) @map("created_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([purpose])
  @@map("files")
}

// ============================================================
// CATALOG — Categories, Brands (Document 06 Ch.3)
// La relation vers Product sera ajoutée à l'Étape 12, jamais par
// anticipation (Document 01 Ch.7).
// ============================================================
model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Brand {
  id   String @id @default(uuid())
  name String
  slug String @unique
  logo String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brands")
}
