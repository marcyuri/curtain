{
  "name": "love-can-build-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Back Office / API — LOVE CAN BUILD",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
